{
  "name": "triage-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "build:wasm": "cd crates/ioc-extractor && wasm-pack build --target web --out-dir ../../src/wasm/ioc-extractor --release && rm -f ../../src/wasm/ioc-extractor/.gitignore",
    "license:keygen": "node scripts/license.mjs keygen",
    "license:issue": "node scripts/license.mjs issue",
    "license:verify": "node scripts/license.mjs verify",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "description": "Offline incident response workspace for SOC analysts and on-call engineers."
